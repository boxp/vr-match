{:objects
 {:Platforms
  {:fields {:id {:type Int}
            :name {:type String}
            :url {:type String}}}
  :User
  {:fields {:id {:type Int}
            :userName {:type String}
            :introduction {:type String}
            :image {:type (list String)}
            :platforms {:type (list :Platforms)}}}
  :NewUser
  {:fields {:user {:type User}
            :session {:type String}}}
  :UserEdge
  {:fields {:cursor {:type String}
            :node {:type :User}}}
  :PageInfo
  {:fields {:startCursor {:type String}
            :endCursor {:type String}
            :hasPreviousPage {:type Boolean}
            :hasNextPage {:type Boolean}}}
  :ApproachList
  {:fields {:total {:type Int
                    :description "取得可能なお相手の総人数"}
            :edges {:type (list UserEdge)}
            :pageInfo {:type :PageInfo}}}}
 :queries
 {:approachList {:type :ApproachList
                 :args {:first {:type Int
                                :optional true}
                        :after {:type String
                                :optional true}
                        :last {:type Int
                               :optional true}
                        :before {:type String
                                 :optional true}}
                 :resolve :resolve-approach-list}}
 :mutations
 {:registerUser {:type :NewUser
                 :description "ユーザー新規登録"
                 :args {:idToken {:type String}}
                 :resolve :resolve-register-user}}}
