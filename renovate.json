{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": ["org.clojure/clojurescript"],
      "enabled": false
    },
    {
      "matchPackageNames": ["reagent"],
      "allowedVersions": "0.8.1"
    }
  ]
}
